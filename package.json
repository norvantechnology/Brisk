{
  "name": "brisk-backend",
  "version": "1.0.0",
  "description": "BRISK Monolith Backend",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc",
    "render-build": "npm install && npm run db:generate && npm run db:push:deploy && npm run build",
    "start": "node dist/server.js",
    "db:generate": "prisma generate --schema=src/database/schema.prisma",
    "db:migrate": "prisma migrate dev --schema=src/database/schema.prisma",
    "db:migrate:deploy": "prisma migrate deploy --schema=src/database/schema.prisma",
    "db:push": "prisma db push --schema=src/database/schema.prisma",
    "db:push:deploy": "prisma db push --schema=src/database/schema.prisma --accept-data-loss",
    "db:seed": "prisma db seed --schema=src/database/schema.prisma",
    "db:studio": "prisma studio --schema=src/database/schema.prisma"
  },
  "dependencies": {
    "@prisma/client": "^5.16.1",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.3.0",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1",
    "winston": "^3.13.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^20.14.9",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "prisma": "^5.16.1",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.5.2"
  },
  "prisma": {
    "seed": "ts-node src/database/seeders/index.ts"
  }
}
