# Server Configuration
PORT=3000
NODE_ENV=development

# Database Configuration
DATABASE_URL=postgresql://user:password@host:port/dbname?pgbouncer=true
DIRECT_URL=postgresql://user:password@host:port/dbname

# Security Configuration
JWT_SECRET=super_secret_jwt_key_change_me_in_production

# Optional: base URL for category icon images (mobile GET /categories iconUrl)
# CATEGORY_ICON_BASE_URL=https://cdn.brisk.com/icons/categories

# File uploads (local disk now → S3 later, same API response)
# UPLOAD_DIR=./data/uploads
# Render: attach persistent disk at /data/uploads and set UPLOAD_DIR=/data/uploads
# VPS: use default ./data/uploads (persists on server disk)
# UPLOAD_PUBLIC_BASE_URL=https://your-api.railway.app
# UPLOAD_MAX_MB=10
# UPLOAD_STORAGE=local

# Contact / survey emails
# Visible From for users (preferred):
# CONTACT_FROM_EMAIL=noreply@brisk.ie
# MAIL_FROM=noreply@brisk.ie
# CONTACT_ADMIN_EMAIL=support@brisk.ie
#
# SMTP auth (can be a different mailbox temporarily, e.g. Hostinger):
# SMTP_HOST=smtp.hostinger.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=you@your-hostinger-mailbox.com
# SMTP_PASS=secret
#
# Note: For users to always see noreply@brisk.ie, create that mailbox (or alias)
# on the SMTP provider and use it as SMTP_USER, or allow that From address.
#
# Email logos are hosted (not attached): {PUBLIC_API_URL}/assets/email/brisk-logo.png
# PUBLIC_API_URL=https://api.brisk.ie

# Stripe (returned on POST /payments/intent — mobile reads from API, do not hardcode)
# STRIPE_PUBLISHABLE_KEY=pk_test_...
# STRIPE_MERCHANT_IDENTIFIER=merchant.com.brisk
