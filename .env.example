# Server Configuration
PORT=3000
NODE_ENV=development

# Database Configuration
DATABASE_URL=postgresql://user:password@host:port/dbname?pgbouncer=true
DIRECT_URL=postgresql://user:password@host:port/dbname

# Security Configuration
JWT_SECRET=super_secret_jwt_key_change_me_in_production

# Optional: base URL for category icon images (mobile GET /categories iconUrl)
# CATEGORY_ICON_BASE_URL=https://cdn.brisk.com/icons/categories

# File uploads (local disk now → S3 later, same API response)
# UPLOAD_DIR=./data/uploads
# UPLOAD_PUBLIC_BASE_URL=https://your-api.railway.app
# UPLOAD_MAX_MB=10
# UPLOAD_STORAGE=local

# Contact Us emails (mock logged until SMTP/SES — submission still saves to DB)
# CONTACT_ADMIN_EMAIL=support@briskmarket.com
# CONTACT_FROM_EMAIL=noreply@briskmarket.com
