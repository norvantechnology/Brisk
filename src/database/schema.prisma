datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ==========================================
// ENUMS
// ==========================================

enum UserRole {
  CUSTOMER
  TRADER
}

enum AdminRole {
  ADMIN
  SUPER_ADMIN
}

enum AdminStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum TraderType {
  SOLO
  COMPANY
}

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
  SUSPENDED
}

enum JobStatus {
  DRAFT
  PUBLISHED
  QUOTED
  ACCEPTED
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  PAYMENT_PENDING
}

enum QuoteStatus {
  PENDING
  ACCEPTED
  REJECTED
  EXPIRED
}

enum BookingStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  RESCHEDULED
}

enum InvoiceStatus {
  UNPAID
  PAID
  REFUNDED
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
}

enum PaymentMethod {
  CARD
  APPLE_PAY
  GOOGLE_PAY
}

enum BillingType {
  INDIVIDUAL
  COMPANY
}

enum PayoutStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum OfferType {
  PLATFORM
  TRADER
}

enum OfferStatus {
  ACTIVE
  EXPIRED
  DISABLED
}

enum DiscountType {
  FLAT
  PERCENTAGE
  FREE_SERVICE
}

enum OfferClaimStatus {
  CLAIMED
  USED
  EXPIRED
  CANCELLED
}

enum OfferCtaAction {
  CLAIM
  BOOK_INSPECTION
}

enum UserStatus {
  ACTIVE
  INACTIVE
  PENDING
  BLOCKED
  SUSPENDED
}

enum DeletionRequestStatus {
  PENDING
  UNDER_REVIEW
  APPROVED
  REJECTED
  COMPLETED
}

enum RefundStatus {
  PENDING
  APPROVED
  COMPLETED
  REJECTED
}

enum ActorType {
  SYSTEM
  ADMIN
  TRADER
  CUSTOMER
}

enum CmsAudience {
  BOTH
  CUSTOMER
  TRADER
}

enum CmsPublishStatus {
  DRAFT
  SCHEDULED
  PUBLISHED
  ARCHIVED
}

enum CmsActiveStatus {
  ACTIVE
  INACTIVE
}

enum CmsKnowledgeBlockType {
  STEP_CARD
  FEATURE_CARD
  TEXT_BLOCK
  CTA_BANNER
}

enum CmsTestimonialPageType {
  CUSTOMER
  TRADER
  HOME
  ABOUT_US
}

enum SurveyRegistrationStatus {
  NEW
  PENDING
  REVIEWED
  CONTACTED
  REJECTED
}

/// Who enters the job price for this sub-category (when price field is shown).
enum SubcategoryPriceEnteredBy {
  CUSTOMER
  TRADER
}

enum DocumentRuleScope {
  ENTITY
  CATEGORY
}

enum TraderOnboardingStatus {
  NOT_STARTED
  IN_PROGRESS
  SUBMITTED
  APPROVED
  REJECTED
}

enum TraderDocumentStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
}

// ==========================================
// CORE AUTH & USERS
// ==========================================

model User {
  id                 String     @id @default(uuid()) @db.Uuid
  customerCode       String?    @unique @map("customer_code")
  fullName           String     @map("full_name")
  email              String     @unique
  mobileNumber       String     @unique @map("mobile_number")
  alternatePhone     String?    @map("alternate_phone")
  passwordHash       String     @map("password_hash")
  profilePhotoUrl    String?    @map("profile_photo_url")
  appleIdToken       String?    @map("apple_id_token")
  mobileVerified     Boolean    @default(false) @map("mobile_verified")
  emailVerified      Boolean    @default(false) @map("email_verified")
  role               UserRole   @default(CUSTOMER)
  status             UserStatus @default(ACTIVE)
  city               String?
  country            String?
  preferredLanguage  String?    @default("English (UK)") @map("preferred_language")
  preferredTimeSlot  String?    @default("Morning (09:00 - 12:00)") @map("preferred_time_slot")
  emailNotifications Boolean    @default(true) @map("email_notifications")
  smsAlerts          Boolean    @default(true) @map("sms_alerts")
  promoNotifications Boolean    @default(false) @map("promo_notifications")
  /// Bumped to revoke all issued JWTs (access + refresh). Missing `tv` on old tokens is treated as 0.
  tokenVersion       Int        @default(0) @map("token_version")
  createdAt          DateTime   @default(now()) @map("created_at")
  updatedAt          DateTime   @updatedAt @map("updated_at")

  // Relationships
  traderProfile          Trader?
  addresses              Address[]
  properties             Property[]
  meterReadings          MeterReading[]
  jobs                   Job[]
  bookings               Booking[]
  payments               Payment[]
  refunds                Refund[]
  loyaltyAccount         LoyaltyAccount?
  savedTraders           SavedTrader[]
  ratingsGiven           RatingReview[]             @relation("CustomerReviews")
  chatMessages           ChatMessage[]
  notifications          Notification[]
  accountDeletionRequest AccountDeletionRequest?
  offerClaims            OfferClaim[]

  @@map("users")
}

model AdminUser {
  id              String      @id @default(uuid()) @db.Uuid
  fullName        String      @map("full_name")
  email           String      @unique
  mobileNumber    String?     @map("mobile_number")
  address         String?
  passwordHash    String      @map("password_hash")
  role            AdminRole   @default(ADMIN)
  status          AdminStatus @default(ACTIVE)
  profilePhotoUrl String?     @map("profile_photo_url")
  joinedAt        DateTime    @default(now()) @map("joined_at")
  lastLoginAt     DateTime?   @map("last_login_at")
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  // Relationships
  createdOffers           Offer[]                  @relation("CreatedByAdmin")
  processedPayouts        Payout[]                 @relation("ProcessedByAdmin")
  processedRefunds        Refund[]                 @relation("RefundProcessedByAdmin")
  reviewedDeletionRequest AccountDeletionRequest[] @relation("ReviewedByAdmin")
  updatedCmsPages         CmsStaticPage[]          @relation("CmsPageUpdatedBy")
  createdBlogPosts        CmsBlogPost[]            @relation("CmsBlogCreatedBy")
  publishedLegalVersions  CmsLegalPolicyVersion[]  @relation("CmsLegalPublishedBy")
  updatedSeoSettings      CmsSeoSettings[]         @relation("CmsSeoUpdatedBy")
  updatedContactSettings  CmsContactSettings[]     @relation("CmsContactUpdatedBy")
  reviewedSurveyConsumers SurveyConsumerRegistration[] @relation("SurveyConsumerReviewedBy")
  reviewedSurveyTraders   SurveyTraderRegistration[]   @relation("SurveyTraderReviewedBy")
  reviewedContactSubmissions ContactSubmission[]       @relation("ContactSubmissionReviewedBy")

  @@map("admin_users")
}

model Trader {
  id                 String             @id @default(uuid()) @db.Uuid
  userId             String             @unique @map("user_id") @db.Uuid
  traderType         TraderType         @default(SOLO) @map("trader_type")
  businessName       String?            @map("business_name")
  bio                String?            @db.Text
  profilePhotoUrl    String?            @map("profile_photo_url")
  coverImageUrl      String?            @map("cover_image_url")
  yearsExperience    Int?               @default(0) @map("years_experience")
  jobsDoneCount      Int                @default(0) @map("jobs_done_count")
  avgRating          Decimal            @default(0.0) @db.Decimal(3, 2) @map("avg_rating")
  topRated           Boolean            @default(false) @map("top_rated")
  traderCode         String?            @unique @map("trader_code")
  verificationStatus VerificationStatus @default(PENDING) @map("verification_status")
  status             String             @default("active") // active | inactive | suspended
  stripeAccountId    String?            @map("stripe_account_id")
  serviceRadius      String?            @map("service_radius")
  bankAccountRef     String?            @map("bank_account_ref")
  categoryId         String?            @map("category_id") @db.Uuid
  fullLegalName      String?            @map("full_legal_name")
  ppsNumber          String?            @map("pps_number")
  croNumber          String?            @map("cro_number")
  vatNumber          String?            @map("vat_number")
  directorFullName   String?            @map("director_full_name")
  addressLine1       String?            @map("address_line_1")
  addressLine2       String?            @map("address_line_2")
  city               String?
  postcode           String?
  country            String?            @default("Ireland")
  bankHolderName     String?            @map("bank_holder_name")
  bankName           String?            @map("bank_name")
  accountNumber      String?            @map("account_number")
  ifscCode           String?            @map("ifsc_code")
  bankDetailsSkipped Boolean            @default(false) @map("bank_details_skipped")
  serviceRadiusKm    Int?               @map("service_radius_km")
  serviceCenterLat   Decimal?           @map("service_center_lat") @db.Decimal(10, 7)
  serviceCenterLng   Decimal?           @map("service_center_lng") @db.Decimal(10, 7)
  serviceCenterLabel String?            @map("service_center_label")
  onboardingStatus   TraderOnboardingStatus @default(NOT_STARTED) @map("onboarding_status")
  onboardingSubmittedAt DateTime?       @map("onboarding_submitted_at")
  rejectionReason    String?            @map("rejection_reason") @db.Text
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")

  // Relationships
  user            User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  category        Category?            @relation(fields: [categoryId], references: [id])
  categories      TraderCategory[]
  documents       TraderDocument[]
  quotes          Quote[]
  bookings        Booking[]
  payouts         Payout[]
  offers          Offer[]              @relation("TraderOffers")
  briskOffers     BriskOffer[]
  ratingsReceived RatingReview[]       @relation("TraderReviews")
  savedBy         SavedTrader[]
  registrations   TraderRegistration[]

  @@map("traders")
}

// ==========================================
// ADDRESSES & PROPERTIES
// ==========================================

model Address {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  /// Home | Work | Custom (Figma address type pills)
  label        String?  // e.g. Home, Work, Custom
  addressType  String   @default("Home") @map("address_type")
  houseNumber  String?  @map("house_number")
  addressLine1 String   @map("address_line_1")
  addressLine2 String?  @map("address_line_2")
  city         String
  county       String?
  eircode      String?
  country      String   @default("Ireland")
  mprnNumber   String?  @map("mprn_number")
  gprnNumber   String?  @map("gprn_number")
  utnNumber    String?  @map("utn_number")
  latitude     Float?
  longitude    Float?
  mapImageUrl  String?  @map("map_image_url")
  isDefault    Boolean  @default(false) @map("is_default")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  // Relationships
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  property Property?

  @@map("addresses")
}

model Property {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  addressId    String?  @unique @map("address_id") @db.Uuid
  propertyName String   @map("property_name")
  addressLine1 String   @map("address_line_1")
  addressLine2 String?  @map("address_line_2")
  city         String
  county       String?
  eircode      String?
  country      String   @default("Ireland")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  // Relationships
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  address       Address?       @relation(fields: [addressId], references: [id], onDelete: SetNull)
  meters        Meter[]
  subscriptions Subscription[]

  @@map("properties")
}

model Meter {
  id            String   @id @default(uuid()) @db.Uuid
  propertyId    String   @map("property_id") @db.Uuid
  /// electricity | gas
  meterType     String   @map("meter_type")
  mprnGprn      String   @map("mprn_gprn")
  serialNumber  String?  @map("serial_number")
  unitLabel     String?  @map("unit_label") // kWh | m³
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  // Relationships
  property Property       @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  readings MeterReading[]

  @@map("meters")
}

model MeterReading {
  id           String   @id @default(uuid()) @db.Uuid
  meterId      String   @map("meter_id") @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  readingValue Decimal  @map("reading_value") @db.Decimal(10, 2)
  readingDate  DateTime @default(now()) @map("reading_date")
  photoUrl     String?  @map("photo_url")
  status       String   @default("pending") // pending | accepted | rejected
  createdAt    DateTime @default(now()) @map("created_at")

  // Relationships
  meter Meter @relation(fields: [meterId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("meter_readings")
}

model UtilityProvider {
  id           String   @id @default(uuid()) @db.Uuid
  name         String
  /// bins | electricity | gas | insurance
  serviceType  String   @map("service_type")
  serviceLabel String?  @map("service_label") // Bins, Electricity, GAS, Home Insurance
  description  String?  // e.g. Building & Contents cover
  logoUrl      String?  @map("logo_url")
  iconUrl      String?  @map("icon_url")
  contactPhone String?  @map("contact_phone")
  displayOrder Int      @default(0) @map("display_order")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")

  // Relationships
  subscriptions Subscription[]

  @@map("utility_providers")
}

model Subscription {
  id                String   @id @default(uuid()) @db.Uuid
  propertyId        String   @map("property_id") @db.Uuid
  utilityProviderId String   @map("utility_provider_id") @db.Uuid
  serviceType       String   @map("service_type")
  accountNumber     String?  @map("account_number")
  status            String   @default("active") // active | cancelled
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  // Relationships
  property        Property        @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  utilityProvider UtilityProvider @relation(fields: [utilityProviderId], references: [id], onDelete: Cascade)

  @@unique([propertyId, utilityProviderId])
  @@map("subscriptions")
}

// ==========================================
// CATEGORIES & SUBCATEGORIES
// ==========================================

model Category {
  id              String   @id @default(uuid()) @db.Uuid
  name            String
  categoryCode    String   @unique @map("category_code")
  urlSlug         String   @unique @map("url_slug")
  description     String?  @db.Text
  iconName        String?  @map("icon_name")
  brandThemeColor String?  @map("brand_theme_color")
  bannerImageUrl  String?  @map("banner_image_url")
  displayOrder    Int      @default(0) @map("display_order")
  status          String   @default("active") // active | inactive
  featured        Boolean  @default(false)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  // Relationships
  subcategories Subcategory[]
  traders       Trader[]
  traderCategories TraderCategory[]
  documentRules DocumentRule[]
  jobs          Job[]
  offers        OfferCategory[]

  @@map("categories")
}

model Subcategory {
  id                 String                      @id @default(uuid()) @db.Uuid
  categoryId         String                      @map("category_id") @db.Uuid
  name               String
  serviceType        String?                     @map("service_type")
  code               String?
  urlSlug            String                      @map("url_slug")
  featured           Boolean                     @default(false)
  status             String                      @default("active") // active | inactive
  /// Admin toggle: site visit required / available for this service
  siteVisitEnabled   Boolean                     @default(false) @map("site_visit_enabled")
  /// Admin toggle: show price field when posting a job for this sub-category
  priceEnabled       Boolean                     @default(true) @map("price_enabled")
  /// Who fills the price when priceEnabled=true
  priceEnteredBy     SubcategoryPriceEnteredBy   @default(CUSTOMER) @map("price_entered_by")
  /// Admin-built Q&A form schema (JSON). Mobile apps render these fields when posting a job.
  qaFormSchema       Json?                       @map("qa_form_schema")
  createdAt          DateTime                    @default(now()) @map("created_at")
  updatedAt          DateTime                    @updatedAt @map("updated_at")

  // Relationships
  category Category           @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  jobs     Job[]
  offers   OfferSubcategory[]

  @@map("subcategories")
}

// ==========================================
// JOBS & QUOTES
// ==========================================

model Job {
  id            String    @id @default(uuid()) @db.Uuid
  jobRef        String?   @unique @map("job_ref")
  customerId    String    @map("customer_id") @db.Uuid
  categoryId    String    @map("category_id") @db.Uuid
  subcategoryId String?   @map("subcategory_id") @db.Uuid
  offerId       String?   @map("offer_id") @db.Uuid
  title         String
  description   String    @db.Text
  addressLine   String?   @map("address_line")
  city          String?
  postcode      String?
  status        JobStatus @default(DRAFT)
  scheduledDate DateTime? @map("scheduled_date")
  /// Answers to subcategory.qaFormSchema when the job was posted (fieldId → value)
  qaFormAnswers Json?     @map("qa_form_answers")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  // Relationships
  customer     User          @relation(fields: [customerId], references: [id], onDelete: Cascade)
  category     Category      @relation(fields: [categoryId], references: [id])
  subcategory  Subcategory?  @relation(fields: [subcategoryId], references: [id])
  offer        Offer?        @relation(fields: [offerId], references: [id])
  photos       JobPhoto[]
  quotes       Quote[]
  booking      Booking?
  chatMessages ChatMessage[]

  @@map("jobs")
}

model JobPhoto {
  id        String   @id @default(uuid()) @db.Uuid
  jobId     String   @map("job_id") @db.Uuid
  photoUrl  String   @map("photo_url")
  createdAt DateTime @default(now()) @map("created_at")

  // Relationships
  job Job @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@map("job_photos")
}

model Quote {
  id            String      @id @default(uuid()) @db.Uuid
  jobId         String      @map("job_id") @db.Uuid
  traderId      String      @map("trader_id") @db.Uuid
  quotedAmount  Decimal     @map("quoted_amount") @db.Decimal(10, 2)
  notes         String?     @db.Text
  estimatedDays Int?        @map("estimated_days")
  status        QuoteStatus @default(PENDING)
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")

  // Relationships
  job    Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)
  trader Trader @relation(fields: [traderId], references: [id], onDelete: Cascade)

  @@map("quotes")
}

// ==========================================
// BOOKINGS, INVOICES & PAYMENTS
// ==========================================

model Booking {
  id            String        @id @default(uuid()) @db.Uuid
  bookingRef    String?       @unique @map("booking_ref")
  jobId         String        @unique @map("job_id") @db.Uuid
  traderId      String        @map("trader_id") @db.Uuid
  customerId    String        @map("customer_id") @db.Uuid
  scheduledDate DateTime      @map("scheduled_date")
  status        BookingStatus @default(SCHEDULED)
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  // Relationships
  job          Job           @relation(fields: [jobId], references: [id], onDelete: Cascade)
  trader       Trader        @relation(fields: [traderId], references: [id])
  customer     User          @relation(fields: [customerId], references: [id])
  invoice      Invoice?
  ratingReview RatingReview?
  chatMessages ChatMessage[]

  @@map("bookings")
}

model Invoice {
  id                  String        @id @default(uuid()) @db.Uuid
  invoiceNumber       String?       @unique @map("invoice_number")
  bookingId           String        @unique @map("booking_id") @db.Uuid
  serviceCharge       Decimal       @map("service_charge") @db.Decimal(10, 2)
  traderOfferDiscount Decimal       @default(0.0) @map("trader_offer_discount") @db.Decimal(10, 2)
  promoDiscount       Decimal       @default(0.0) @map("promo_discount") @db.Decimal(10, 2)
  platformFee         Decimal       @default(0.0) @map("platform_fee") @db.Decimal(10, 2)
  tax                 Decimal       @default(0.0) @db.Decimal(10, 2)
  totalAmount         Decimal       @map("total_amount") @db.Decimal(10, 2)
  status              InvoiceStatus @default(UNPAID)
  createdAt           DateTime      @default(now()) @map("created_at")
  updatedAt           DateTime      @updatedAt @map("updated_at")

  // Relationships
  booking  Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  payments Payment[]

  @@map("invoices")
}

model Payment {
  id                    String        @id @default(uuid()) @db.Uuid
  transactionRef        String?       @unique @map("transaction_ref")
  invoiceId             String        @map("invoice_id") @db.Uuid
  userId                String        @map("user_id") @db.Uuid
  stripePaymentIntentId String?       @map("stripe_payment_intent_id")
  method                PaymentMethod @default(CARD)
  billingType           BillingType   @default(INDIVIDUAL) @map("billing_type")
  companyName           String?       @map("company_name")
  tinNumber             String?       @map("tin_number")
  serviceCharge         Decimal?      @map("service_charge") @db.Decimal(10, 2)
  feeAmount             Decimal?      @default(0.0) @map("fee_amount") @db.Decimal(10, 2)
  discountAmount        Decimal?      @default(0.0) @map("discount_amount") @db.Decimal(10, 2)
  cardLast4             String?       @map("card_last4")
  cardBrand             String?       @map("card_brand")
  amount                Decimal       @db.Decimal(10, 2)
  status                PaymentStatus @default(PENDING)
  paidAt                DateTime?     @map("paid_at")
  createdAt             DateTime      @default(now()) @map("created_at")
  updatedAt             DateTime      @updatedAt @map("updated_at")

  // Relationships
  invoice Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  refunds Refund[]

  @@map("payments")
}

model Refund {
  id             String       @id @default(uuid()) @db.Uuid
  refundRef      String       @unique @map("refund_ref")
  transactionRef String?      @map("transaction_ref")
  paymentId      String?      @map("payment_id") @db.Uuid
  userId         String       @map("user_id") @db.Uuid
  originalAmount Decimal      @map("original_amount") @db.Decimal(10, 2)
  refundAmount   Decimal      @map("refund_amount") @db.Decimal(10, 2)
  reason         String       @db.Text
  status         RefundStatus @default(PENDING)
  processedById  String?      @map("processed_by_id") @db.Uuid
  processedAt    DateTime?    @map("processed_at")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  // Relationships
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  payment     Payment?   @relation(fields: [paymentId], references: [id])
  processedBy AdminUser? @relation("RefundProcessedByAdmin", fields: [processedById], references: [id])

  @@map("refunds")
}

model Payout {
  id               String       @id @default(uuid()) @db.Uuid
  traderId         String       @map("trader_id") @db.Uuid
  amount           Decimal      @db.Decimal(10, 2)
  status           PayoutStatus @default(PENDING)
  stripeTransferId String?      @map("stripe_transfer_id")
  processedAt      DateTime?    @map("processed_at")
  processedById    String?      @map("processed_by_id") @db.Uuid
  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @updatedAt @map("updated_at")

  // Relationships
  trader      Trader     @relation(fields: [traderId], references: [id], onDelete: Cascade)
  processedBy AdminUser? @relation("ProcessedByAdmin", fields: [processedById], references: [id])

  @@map("payouts")
}



// ==========================================
// OFFERS & PROMO CODES
// ==========================================

model Offer {
  id               String       @id @default(uuid()) @db.Uuid
  offerCode        String       @unique @map("offer_code")
  offerType        OfferType    @default(PLATFORM) @map("offer_type")
  title            String
  badgeTag         String?      @map("badge_tag")
  couponCode       String?      @map("coupon_code")
  shortDescription String?      @map("short_description")
  fullDescription  String?      @map("full_description") @db.Text
  bannerImageUrl   String?      @map("banner_image_url")
  discountType     DiscountType @default(FLAT) @map("discount_type")
  discountValue    Decimal      @map("discount_value") @db.Decimal(10, 2)
  discountLabel    String?      @map("discount_label")
  createdById      String?      @map("created_by_id") @db.Uuid
  traderId         String?      @map("trader_id") @db.Uuid
  validFrom        DateTime     @map("valid_from")
  validUntil       DateTime     @map("valid_until")
  status           OfferStatus  @default(ACTIVE)
  claimsCount      Int          @default(0) @map("claims_count")
  revenueGenerated Decimal      @default(0.0) @map("revenue_generated") @db.Decimal(10, 2)
  viewsCount       Int          @default(0) @map("views_count")
  ctaLabel         String?      @map("cta_label")
  ctaAction        OfferCtaAction @default(CLAIM) @map("cta_action")
  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @updatedAt @map("updated_at")

  // Relationships
  createdBy     AdminUser?         @relation("CreatedByAdmin", fields: [createdById], references: [id])
  trader        Trader?            @relation("TraderOffers", fields: [traderId], references: [id])
  categories    OfferCategory[]
  subcategories OfferSubcategory[]
  jobsApplied   Job[]
  promoCodes    PromoCode[]
  claims        OfferClaim[]

  @@map("offers")
}

model BriskOffer {
  id          String   @id @default(uuid()) @db.Uuid
  traderId    String?  @map("trader_id") @db.Uuid
  title       String
  tag         String?
  description String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at")

  // Relationships
  trader Trader? @relation(fields: [traderId], references: [id])

  @@map("brisk_offers")
}

model OfferCategory {
  offerId    String @map("offer_id") @db.Uuid
  categoryId String @map("category_id") @db.Uuid

  offer    Offer    @relation(fields: [offerId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([offerId, categoryId])
  @@map("offer_categories")
}

model OfferSubcategory {
  offerId       String @map("offer_id") @db.Uuid
  subcategoryId String @map("subcategory_id") @db.Uuid

  offer       Offer       @relation(fields: [offerId], references: [id], onDelete: Cascade)
  subcategory Subcategory @relation(fields: [subcategoryId], references: [id], onDelete: Cascade)

  @@id([offerId, subcategoryId])
  @@map("offer_subcategories")
}

model OfferClaim {
  id        String           @id @default(uuid()) @db.Uuid
  offerId   String           @map("offer_id") @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  jobId     String?          @map("job_id") @db.Uuid
  status    OfferClaimStatus @default(CLAIMED)
  claimedAt DateTime         @default(now()) @map("claimed_at")
  usedAt    DateTime?        @map("used_at")
  createdAt DateTime         @default(now()) @map("created_at")
  updatedAt DateTime         @updatedAt @map("updated_at")

  offer Offer @relation(fields: [offerId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([offerId, userId])
  @@index([userId, status])
  @@map("offer_claims")
}

model PromoCode {
  id            String       @id @default(uuid()) @db.Uuid
  offerId       String?      @map("offer_id") @db.Uuid
  code          String       @unique
  discountType  DiscountType @default(FLAT) @map("discount_type")
  discountValue Decimal      @map("discount_value") @db.Decimal(10, 2)
  categoryScope String?      @map("category_scope")
  validFrom     DateTime     @map("valid_from")
  validUntil    DateTime     @map("valid_until")
  active        Boolean      @default(true)
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  // Relationships
  offer Offer? @relation(fields: [offerId], references: [id])

  @@map("promo_codes")
}

