datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ==========================================
// ENUMS
// ==========================================

enum UserRole {
  CUSTOMER
  TRADER
}

enum AdminRole {
  ADMIN
  SUPER_ADMIN
}

enum AdminStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum TraderType {
  SOLO
  COMPANY
}

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
  SUSPENDED
}

enum JobStatus {
  DRAFT
  PUBLISHED
  QUOTED
  ACCEPTED
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  PAYMENT_PENDING
}

enum QuoteStatus {
  PENDING
  ACCEPTED
  REJECTED
  EXPIRED
}

enum BookingStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  RESCHEDULED
}

enum InvoiceStatus {
  UNPAID
  PAID
  REFUNDED
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
}

enum PaymentMethod {
  CARD
  APPLE_PAY
  GOOGLE_PAY
}

enum BillingType {
  INDIVIDUAL
  COMPANY
}

enum PayoutStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum OfferType {
  PLATFORM
  TRADER
}

enum OfferStatus {
  ACTIVE
  EXPIRED
  DISABLED
}

enum DiscountType {
  FLAT
  PERCENTAGE
  FREE_SERVICE
}

enum DeletionRequestStatus {
  PENDING
  UNDER_REVIEW
  APPROVED
  REJECTED
  COMPLETED
}

enum ActorType {
  SYSTEM
  ADMIN
  TRADER
  CUSTOMER
}

// ==========================================
// CORE AUTH & USERS
// ==========================================

model User {
  id             String   @id @default(uuid()) @db.Uuid
  fullName       String   @map("full_name")
  email          String   @unique
  mobileNumber   String   @unique @map("mobile_number")
  passwordHash   String   @map("password_hash")
  appleIdToken   String?  @map("apple_id_token")
  mobileVerified Boolean  @default(false) @map("mobile_verified")
  role           UserRole @default(CUSTOMER)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  // Relationships
  traderProfile          Trader?
  addresses              Address[]
  properties             Property[]
  meterReadings          MeterReading[]
  jobs                   Job[]
  bookings               Booking[]
  payments               Payment[]
  loyaltyAccount         LoyaltyAccount?
  savedTraders           SavedTrader[]
  ratingsGiven           RatingReview[]             @relation("CustomerReviews")
  chatMessages           ChatMessage[]
  notifications          Notification[]
  accountDeletionRequest AccountDeletionRequest?

  @@map("users")
}

model AdminUser {
  id              String      @id @default(uuid()) @db.Uuid
  fullName        String      @map("full_name")
  email           String      @unique
  mobileNumber    String?     @map("mobile_number")
  address         String?
  passwordHash    String      @map("password_hash")
  role            AdminRole   @default(ADMIN)
  status          AdminStatus @default(ACTIVE)
  profilePhotoUrl String?     @map("profile_photo_url")
  joinedAt        DateTime    @default(now()) @map("joined_at")
  lastLoginAt     DateTime?   @map("last_login_at")
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  // Relationships
  createdOffers           Offer[]                  @relation("CreatedByAdmin")
  processedPayouts        Payout[]                 @relation("ProcessedByAdmin")
  reviewedDeletionRequest AccountDeletionRequest[] @relation("ReviewedByAdmin")

  @@map("admin_users")
}

model Trader {
  id                 String             @id @default(uuid()) @db.Uuid
  userId             String             @unique @map("user_id") @db.Uuid
  traderType         TraderType         @default(SOLO) @map("trader_type")
  businessName       String?            @map("business_name")
  bio                String?
  yearsExperience    Int?               @map("years_experience")
  jobsDoneCount      Int                @default(0) @map("jobs_done_count")
  avgRating          Decimal            @default(0.0) @db.Decimal(3, 2) @map("avg_rating")
  topRated           Boolean            @default(false) @map("top_rated")
  verificationStatus VerificationStatus @default(PENDING) @map("verification_status")
  traderCode         String?            @unique @map("trader_code")
  serviceRadius      String?            @map("service_radius")
  bankAccountRef     String?            @map("bank_account_ref")
  categoryId         String?            @map("category_id") @db.Uuid
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")

  // Relationships
  user            User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  category        Category?            @relation(fields: [categoryId], references: [id])
  quotes          Quote[]
  bookings        Booking[]
  ratingsReceived RatingReview[]       @relation("TraderReviews")
  offers          Offer[]              @relation("TraderOffers")
  briskOffers     BriskOffer[]
  savedBy         SavedTrader[]
  payouts         Payout[]
  registrations   TraderRegistration[]

  @@map("traders")
}

// ==========================================
// PROPERTY & UTILITIES
// ==========================================

model Address {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  label       String
  addressType String   @default("custom") @map("address_type")
  line1       String
  houseNumber String   @map("house_number")
  city        String
  county      String
  eircode     String
  isPrimary   Boolean  @default(false) @map("is_primary")
  lat         Decimal  @db.Decimal(9, 6)
  lng         Decimal  @db.Decimal(9, 6)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relationships
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  properties Property[]
  jobs       Job[]

  @@map("addresses")
}

model Property {
  id        String   @id @default(uuid()) @db.Uuid
  addressId String   @map("address_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  utnNumber String?  @map("utn_number")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relationships
  address       Address        @relation(fields: [addressId], references: [id], onDelete: Cascade)
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  meters        Meter[]
  subscriptions Subscription[]

  @@map("properties")
}

model Meter {
  id               String   @id @default(uuid()) @db.Uuid
  propertyId       String   @map("property_id") @db.Uuid
  meterType        String   @map("meter_type") // electricity | gas
  referenceNumber  String   @map("reference_number") // MPRN / GPRN
  lastReadingValue Decimal? @map("last_reading_value") @db.Decimal(12, 2)
  lastReadingUnit  String?  @map("last_reading_unit") // kWh | m3
  lastReadingDate  DateTime? @map("last_reading_date")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  // Relationships
  property Property       @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  readings MeterReading[]

  @@map("meters")
}

model MeterReading {
  id           String   @id @default(uuid()) @db.Uuid
  meterId      String   @map("meter_id") @db.Uuid
  submittedById String  @map("submitted_by_id") @db.Uuid
  readingValue Decimal  @map("reading_value") @db.Decimal(12, 2)
  submittedAt  DateTime @default(now()) @map("submitted_at")
  status       String   @default("pending") // pending | accepted | rejected
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  // Relationships
  meter       Meter @relation(fields: [meterId], references: [id], onDelete: Cascade)
  submittedBy User  @relation(fields: [submittedById], references: [id], onDelete: Cascade)

  @@map("meter_readings")
}

model UtilityProvider {
  id           String   @id @default(uuid()) @db.Uuid
  serviceType  String   @map("service_type") // bins | electricity | gas | home_insurance
  providerName String   @map("provider_name")
  logoUrl      String?  @map("logo_url")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  // Relationships
  subscriptions Subscription[]

  @@map("utility_providers")
}

model Subscription {
  id          String   @id @default(uuid()) @db.Uuid
  propertyId  String   @map("property_id") @db.Uuid
  providerId  String   @map("provider_id") @db.Uuid
  serviceType String   @map("service_type")
  status      String   @default("active") // active | pending_closure | closed
  linkedAt    DateTime @default(now()) @map("linked_at")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relationships
  property Property        @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  provider UtilityProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@map("subscriptions")
}

// ==========================================
// CATEGORIES & SUBCATEGORIES
// ==========================================

model Category {
  id              String   @id @default(uuid()) @db.Uuid
  name            String
  categoryCode    String   @unique @map("category_code")
  urlSlug         String   @unique @map("url_slug")
  description     String?  @db.Text
  iconName        String?  @map("icon_name")
  brandThemeColor String?  @map("brand_theme_color")
  bannerImageUrl  String?  @map("banner_image_url")
  displayOrder    Int      @default(0) @map("display_order")
  status          String   @default("active")
  featured        Boolean  @default(false)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  // Relationships
  subcategories Subcategory[]
  jobs          Job[]
  traders       Trader[]
  offers        OfferCategory[]

  @@map("categories")
}

model Subcategory {
  id          String   @id @default(uuid()) @db.Uuid
  categoryId  String   @map("category_id") @db.Uuid
  name        String
  serviceType String?  @map("service_type")
  code        String?
  urlSlug     String   @map("url_slug")
  featured    Boolean  @default(false)
  status      String   @default("active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relationships
  category Category           @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  jobs     Job[]
  offers   OfferSubcategory[]

  @@map("subcategories")
}

// ==========================================
// JOBS & QUOTES
// ==========================================

model Job {
  id                   String    @id @default(uuid()) @db.Uuid
  customerId           String    @map("customer_id") @db.Uuid
  categoryId           String    @map("category_id") @db.Uuid
  subcategoryId        String    @map("subcategory_id") @db.Uuid
  title                String
  description          String    @db.Text
  addressId            String    @map("address_id") @db.Uuid
  preferredDate        DateTime  @map("preferred_date")
  preferredTimeSlot    String    @map("preferred_time_slot")
  duration             String?
  status               JobStatus @default(DRAFT)
  appliedTraderOfferId String?   @map("applied_trader_offer_id") @db.Uuid
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  // Relationships
  customer     User        @relation(fields: [customerId], references: [id], onDelete: Cascade)
  category     Category    @relation(fields: [categoryId], references: [id])
  subcategory  Subcategory @relation(fields: [subcategoryId], references: [id])
  address      Address     @relation(fields: [addressId], references: [id])
  appliedOffer Offer?      @relation(fields: [appliedTraderOfferId], references: [id])
  images       JobImage[]
  quotes       Quote[]
  booking      Booking?
  chatMessages ChatMessage[]

  @@map("jobs")
}

model JobImage {
  id        String   @id @default(uuid()) @db.Uuid
  jobId     String   @map("job_id") @db.Uuid
  s3Key     String   @map("s3_key")
  url       String?
  createdAt DateTime @default(now()) @map("created_at")

  // Relationships
  job Job @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@map("job_images")
}

model Quote {
  id                       String      @id @default(uuid()) @db.Uuid
  jobId                    String      @map("job_id") @db.Uuid
  traderId                 String      @map("trader_id") @db.Uuid
  price                    Decimal     @db.Decimal(10, 2)
  estimatedCompletionTime String?     @map("estimated_completion_time")
  notes                    String?     @db.Text
  status                   QuoteStatus @default(PENDING)
  createdAt                DateTime    @default(now()) @map("created_at")
  updatedAt                DateTime    @updatedAt @map("updated_at")

  // Relationships
  job     Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  trader  Trader   @relation(fields: [traderId], references: [id], onDelete: Cascade)
  booking Booking?

  @@map("quotes")
}

// ==========================================
// BOOKINGS, INVOICES & PAYMENTS
// ==========================================

model Booking {
  id          String        @id @default(uuid()) @db.Uuid
  jobId       String        @unique @map("job_id") @db.Uuid
  quoteId     String        @unique @map("quote_id") @db.Uuid
  traderId    String        @map("trader_id") @db.Uuid
  customerId  String        @map("customer_id") @db.Uuid
  status      BookingStatus @default(SCHEDULED)
  scheduledAt DateTime      @map("scheduled_at")
  completedAt DateTime?     @map("completed_at")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  // Relationships
  job          Job           @relation(fields: [jobId], references: [id], onDelete: Cascade)
  quote        Quote         @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  trader       Trader        @relation(fields: [traderId], references: [id], onDelete: Cascade)
  customer     User          @relation(fields: [customerId], references: [id], onDelete: Cascade)
  invoice      Invoice?
  ratingReview RatingReview?
  chatMessages ChatMessage[]

  @@map("bookings")
}

model Invoice {
  id                  String        @id @default(uuid()) @db.Uuid
  bookingId           String        @unique @map("booking_id") @db.Uuid
  serviceCharge       Decimal       @map("service_charge") @db.Decimal(10, 2)
  traderOfferDiscount Decimal       @default(0.0) @map("trader_offer_discount") @db.Decimal(10, 2)
  promoDiscount       Decimal       @default(0.0) @map("promo_discount") @db.Decimal(10, 2)
  platformFee         Decimal       @default(0.0) @map("platform_fee") @db.Decimal(10, 2)
  tax                 Decimal       @default(0.0) @db.Decimal(10, 2)
  totalAmount         Decimal       @map("total_amount") @db.Decimal(10, 2)
  status              InvoiceStatus @default(UNPAID)
  createdAt           DateTime      @default(now()) @map("created_at")
  updatedAt           DateTime      @updatedAt @map("updated_at")

  // Relationships
  booking  Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  payments Payment[]

  @@map("invoices")
}

model Payment {
  id                    String        @id @default(uuid()) @db.Uuid
  invoiceId             String        @map("invoice_id") @db.Uuid
  userId                String        @map("user_id") @db.Uuid
  stripePaymentIntentId String?       @map("stripe_payment_intent_id")
  method                PaymentMethod @default(CARD)
  billingType           BillingType   @default(INDIVIDUAL) @map("billing_type")
  companyName           String?       @map("company_name")
  tinNumber             String?       @map("tin_number")
  amount                Decimal       @db.Decimal(10, 2)
  status                PaymentStatus @default(PENDING)
  paidAt                DateTime?     @map("paid_at")
  createdAt             DateTime      @default(now()) @map("created_at")
  updatedAt             DateTime      @updatedAt @map("updated_at")

  // Relationships
  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("payments")
}

model Payout {
  id               String       @id @default(uuid()) @db.Uuid
  traderId         String       @map("trader_id") @db.Uuid
  amount           Decimal      @db.Decimal(10, 2)
  status           PayoutStatus @default(PENDING)
  stripeTransferId String?      @map("stripe_transfer_id")
  processedAt      DateTime?    @map("processed_at")
  processedById    String?      @map("processed_by_id") @db.Uuid
  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @updatedAt @map("updated_at")

  // Relationships
  trader      Trader     @relation(fields: [traderId], references: [id], onDelete: Cascade)
  processedBy AdminUser? @relation("ProcessedByAdmin", fields: [processedById], references: [id])

  @@map("payouts")
}

// ==========================================
// OFFERS & PROMO CODES
// ==========================================

model Offer {
  id               String       @id @default(uuid()) @db.Uuid
  offerCode        String       @unique @map("offer_code")
  offerType        OfferType    @default(PLATFORM) @map("offer_type")
  title            String
  badgeTag         String?      @map("badge_tag")
  couponCode       String?      @map("coupon_code")
  shortDescription String?      @map("short_description")
  fullDescription  String?      @map("full_description") @db.Text
  bannerImageUrl   String?      @map("banner_image_url")
  discountType     DiscountType @default(FLAT) @map("discount_type")
  discountValue    Decimal      @map("discount_value") @db.Decimal(10, 2)
  discountLabel    String?      @map("discount_label")
  createdById      String?      @map("created_by_id") @db.Uuid
  traderId         String?      @map("trader_id") @db.Uuid
  validFrom        DateTime     @map("valid_from")
  validUntil       DateTime     @map("valid_until")
  status           OfferStatus  @default(ACTIVE)
  claimsCount      Int          @default(0) @map("claims_count")
  revenueGenerated Decimal      @default(0.0) @map("revenue_generated") @db.Decimal(10, 2)
  viewsCount       Int          @default(0) @map("views_count")
  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @updatedAt @map("updated_at")

  // Relationships
  createdBy     AdminUser?         @relation("CreatedByAdmin", fields: [createdById], references: [id])
  trader        Trader?            @relation("TraderOffers", fields: [traderId], references: [id])
  categories    OfferCategory[]
  subcategories OfferSubcategory[]
  jobsApplied   Job[]
  promoCodes    PromoCode[]

  @@map("offers")
}

model BriskOffer {
  id          String   @id @default(uuid()) @db.Uuid
  traderId    String?  @map("trader_id") @db.Uuid
  title       String
  tag         String?
  description String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at")

  // Relationships
  trader Trader? @relation(fields: [traderId], references: [id])

  @@map("brisk_offers")
}

model OfferCategory {
  offerId    String @map("offer_id") @db.Uuid
  categoryId String @map("category_id") @db.Uuid

  offer    Offer    @relation(fields: [offerId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([offerId, categoryId])
  @@map("offer_categories")
}

model OfferSubcategory {
  offerId       String @map("offer_id") @db.Uuid
  subcategoryId String @map("subcategory_id") @db.Uuid

  offer       Offer       @relation(fields: [offerId], references: [id], onDelete: Cascade)
  subcategory Subcategory @relation(fields: [subcategoryId], references: [id], onDelete: Cascade)

  @@id([offerId, subcategoryId])
  @@map("offer_subcategories")
}

model PromoCode {
  id            String       @id @default(uuid()) @db.Uuid
  offerId       String?      @map("offer_id") @db.Uuid
  code          String       @unique
  discountType  DiscountType @default(FLAT) @map("discount_type")
  discountValue Decimal      @map("discount_value") @db.Decimal(10, 2)
  categoryScope String?      @map("category_scope")
  validFrom     DateTime     @map("valid_from")
  validUntil    DateTime     @map("valid_until")
  active        Boolean      @default(true)
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  // Relationships
  offer Offer? @relation(fields: [offerId], references: [id])

  @@map("promo_codes")
}

// ==========================================
// LOYALTY & REWARDS
// ==========================================

model LoyaltyAccount {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @unique @map("user_id") @db.Uuid
  pointsBalance Int      @default(0) @map("points_balance")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  // Relationships
  user         User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions LoyaltyTransaction[]
  redemptions  LoyaltyRedemption[]

  @@map("loyalty_accounts")
}

model LoyaltyOffer {
  id             String   @id @default(uuid()) @db.Uuid
  title          String
  pointsRequired Int      @map("points_required")
  description    String?  @db.Text
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  // Relationships
  redemptions LoyaltyRedemption[]

  @@map("loyalty_offers")
}

model LoyaltyRedemption {
  id               String   @id @default(uuid()) @db.Uuid
  loyaltyAccountId String   @map("loyalty_account_id") @db.Uuid
  loyaltyOfferId   String   @map("loyalty_offer_id") @db.Uuid
  redeemCode       String   @unique @map("redeem_code")
  pointsSpent      Int      @map("points_spent")
  validUntil       DateTime @map("valid_until")
  status           String   @default("claimed") // claimed | used | expired
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  // Relationships
  loyaltyAccount LoyaltyAccount @relation(fields: [loyaltyAccountId], references: [id], onDelete: Cascade)
  loyaltyOffer   LoyaltyOffer   @relation(fields: [loyaltyOfferId], references: [id], onDelete: Cascade)

  @@map("loyalty_redemptions")
}

model LoyaltyTransaction {
  id               String   @id @default(uuid()) @db.Uuid
  loyaltyAccountId String   @map("loyalty_account_id") @db.Uuid
  pointsChange     Int      @map("points_change")
  reason           String
  createdAt        DateTime @default(now()) @map("created_at")

  // Relationships
  loyaltyAccount LoyaltyAccount @relation(fields: [loyaltyAccountId], references: [id], onDelete: Cascade)

  @@map("loyalty_transactions")
}

// ==========================================
// MISCELLANEOUS FEATURES
// ==========================================

model SavedTrader {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  traderId  String   @map("trader_id") @db.Uuid
  savedAt   DateTime @default(now()) @map("saved_at")
  createdAt DateTime @default(now()) @map("created_at")

  // Relationships
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  trader Trader @relation(fields: [traderId], references: [id], onDelete: Cascade)

  @@unique([userId, traderId])
  @@map("saved_traders")
}

model RatingReview {
  id         String   @id @default(uuid()) @db.Uuid
  bookingId  String   @unique @map("booking_id") @db.Uuid
  customerId String   @map("customer_id") @db.Uuid
  traderId   String   @map("trader_id") @db.Uuid
  stars      Int
  review     String?  @db.Text
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  // Relationships
  booking  Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  customer User    @relation("CustomerReviews", fields: [customerId], references: [id], onDelete: Cascade)
  trader   Trader  @relation("TraderReviews", fields: [traderId], references: [id], onDelete: Cascade)

  @@map("ratings_reviews")
}

model ChatMessage {
  id        String   @id @default(uuid()) @db.Uuid
  bookingId String?  @map("booking_id") @db.Uuid
  jobId     String?  @map("job_id") @db.Uuid
  senderId  String   @map("sender_id") @db.Uuid
  message   String   @db.Text
  sentAt    DateTime @default(now()) @map("sent_at")
  createdAt DateTime @default(now()) @map("created_at")

  // Relationships
  booking Booking? @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  job     Job?     @relation(fields: [jobId], references: [id], onDelete: Cascade)
  sender  User     @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@map("chat_messages")
}

model Notification {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  type      String
  payload   Json?
  read      Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  // Relationships
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

model AccountDeletionRequest {
  id          String                @id @default(uuid()) @db.Uuid
  userId      String                @unique @map("user_id") @db.Uuid
  status      DeletionRequestStatus @default(PENDING)
  reason      String?               @db.Text
  reviewedById String?              @map("reviewed_by_id") @db.Uuid
  requestedAt DateTime              @default(now()) @map("requested_at")
  processedAt DateTime?             @map("processed_at")
  createdAt   DateTime              @default(now()) @map("created_at")
  updatedAt   DateTime              @updatedAt @map("updated_at")

  // Relationships
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  reviewedBy AdminUser? @relation("ReviewedByAdmin", fields: [reviewedById], references: [id])

  @@map("account_deletion_requests")
}

model AuditLog {
  id          String    @id @default(uuid()) @db.Uuid
  eventType   String    @map("event_type")
  actorType   ActorType @default(SYSTEM) @map("actor_type")
  actorId     String?   @map("actor_id")
  actorLabel  String?   @map("actor_label")
  subjectType String?   @map("subject_type")
  subjectId   String?   @map("subject_id")
  description String    @db.Text
  createdAt   DateTime  @default(now()) @map("created_at")

  @@map("audit_logs")
}

model TraderRegistration {
  id          String     @id @default(uuid()) @db.Uuid
  entityType  TraderType @default(SOLO) @map("entity_type")
  currentStep Int        @default(1) @map("current_step")
  status      String     @default("in_progress") // in_progress | submitted | approved | rejected
  stepData    Json?      @map("step_data")
  traderId    String?    @map("trader_id") @db.Uuid
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  // Relationships
  trader Trader? @relation(fields: [traderId], references: [id])

  @@map("trader_registrations")
}
