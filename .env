# Server Configuration
PORT=3000
NODE_ENV=development

# Database Configuration
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/brisk_db
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/brisk_db

# Security Configuration
JWT_SECRET=super_secret_jwt_key_change_me_in_production

# Optional: base URL for category icon images (mobile GET /categories iconUrl)
# CATEGORY_ICON_BASE_URL=https://cdn.brisk.com/icons/categories

# File uploads (local disk now → S3 later, same API response)
UPLOAD_DIR=./data/uploads
UPLOAD_MAX_MB=10
UPLOAD_STORAGE=local

# Contact / survey emails
CONTACT_FROM_EMAIL=noreply@brisk.ie
MAIL_FROM=noreply@brisk.ie
CONTACT_ADMIN_EMAIL=admin@brisk.ie

# Public API URL
PUBLIC_API_URL=http://localhost:3000

# Stripe — test / sandbox keys
STRIPE_SECRET_KEY=sk_test_placeholder
STRIPE_PUBLISHABLE_KEY=pk_test_placeholder
STRIPE_WEBHOOK_SECRET=whsec_placeholder
STRIPE_MERCHANT_IDENTIFIER=merchant.ie.brisk
STRIPE_CONNECT_RETURN_URL=https://brisk.ie/stripe/return
STRIPE_CONNECT_REFRESH_URL=https://brisk.ie/stripe/refresh

